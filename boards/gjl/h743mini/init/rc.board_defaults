#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# H743mini minimal-system stage:
# Keep V6C inherited defaults disabled until the matching hardware path is
# actually wired, enabled, and verified.

# PM02 analog power module calibration.
# PM02: voltage divider 18.182, current conversion 36.364 A/V.
param set-default BAT1_SOURCE 0
param set-default BAT1_V_DIV 18.182
param set-default BAT1_A_PER_V 36.364
param set-default BAT1_N_CELLS 3
param set-default BAT1_CAPACITY 5300

# V6C MAVLink Ethernet defaults.
# Disabled for now because H743mini currently uses USB/QGC and CH340/NSH, and
# does not have an Ethernet MAVLink path.
#
# param set-default MAV_2_CONFIG 1000
# param set-default MAV_2_BROADCAST 1
# param set-default MAV_2_MODE 0
# param set-default MAV_2_RADIO_CTL 0
# param set-default MAV_2_RATE 100000
# param set-default MAV_2_REMOTE_PRT 14550
# param set-default MAV_2_UDP_PRT 14550

# H743mini 4G MAVLink on UART5 PB13/PB12 (TEL2).
# Use MAVLink instance 1 in Normal mode without hardware flow control.
param set-default MAV_1_CONFIG 102
param set-default MAV_1_MODE 0
param set-default MAV_1_FLOW_CTRL 0
param set-default MAV_1_RADIO_CTL 0
param set-default MAV_1_RATE 5000
param set-default SER_TEL2_BAUD 115200
